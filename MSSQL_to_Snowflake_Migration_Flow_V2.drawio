  <diagram id="decide" name="2 · Delta Tool Decision">
    <mxGraphModel dx="900" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="820" pageHeight="790" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="d-t" value="Choosing the Delta Sync Option" style="text;html=1;fontSize=20;fontStyle=1;fontColor=#1F2933;align=left;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="700" height="34" as="geometry" />
        </mxCell>
        <mxCell id="d-pre" value="&lt;b&gt;Context:&lt;/b&gt; 3–4 TB · tables only · ≤16 columns · 10 simple data types.&lt;br&gt;&lt;b&gt;Before any option:&lt;/b&gt; primary keys on all tables · DBA approval for Change Tracking / CDC · SQL Server version &amp;amp; edition check · delete handling agreed" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F7F8FA;strokeColor=#9AA5B1;strokeWidth=1;fontSize=11;align=left;spacingLeft=12;fontColor=#3E4C59;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="56" width="740" height="62" as="geometry" />
        </mxCell>
        <mxCell id="d1" value="How fresh must&lt;br&gt;delta data be?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#52606D;strokeWidth=1;fontSize=11;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="300" y="135" width="220" height="115" as="geometry" />
        </mxCell>
        <mxCell id="d2" value="Network path from&lt;br&gt;Snowflake to on-prem&lt;br&gt;allowed?&lt;br&gt;&lt;font color=&quot;#7B8794&quot; style=&quot;font-size:9px&quot;&gt;VPN / Private Link / IP allow-list&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#52606D;strokeWidth=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="60" y="300" width="240" height="135" as="geometry" />
        </mxCell>
        <mxCell id="d3" value="Licence budget&lt;br&gt;AND many tables&lt;br&gt;(100+)?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#52606D;strokeWidth=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="520" y="300" width="240" height="135" as="geometry" />
        </mxCell>
        <mxCell id="oA" value="&lt;font color=&quot;#C25E0B&quot;&gt;Option A&lt;/font&gt;&lt;br&gt;&lt;b&gt;Openflow SQL Server connector&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#616E7C&quot;&gt;native · CDC or Change Tracking&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FDF0E4;strokeColor=#E67E22;strokeWidth=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="30" y="495" width="210" height="80" as="geometry" />
        </mxCell>
        <mxCell id="oC" value="&lt;font color=&quot;#C25E0B&quot;&gt;Option C&lt;/font&gt;&lt;br&gt;&lt;b&gt;Fivetran/HVR · Qlik Replicate&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#616E7C&quot;&gt;agent inside network, outbound only&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FDF0E4;strokeColor=#E67E22;strokeWidth=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="305" y="495" width="210" height="80" as="geometry" />
        </mxCell>
        <mxCell id="oB" value="&lt;font color=&quot;#2E7D32&quot;&gt;&lt;b&gt;★ Option B · RECOMMENDED&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;Python + Airflow&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#616E7C&quot;&gt;Change Tracking → stage → MERGE&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EEF7EF;strokeColor=#2E7D32;strokeWidth=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="580" y="495" width="210" height="80" as="geometry" />
        </mxCell>
        <mxCell id="d-note" value="&lt;b&gt;Historical load (3–4 TB)&lt;/b&gt; always uses bulk export – Python → Parquet → PUT → COPY INTO (bcp for numeric-only tables) – whichever delta option is chosen. Record the Change Tracking version before extract." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=1;fontSize=11;align=left;spacingLeft=12;fontColor=#1F2933;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="610" width="740" height="50" as="geometry" />
        </mxCell>
        <mxCell id="d-no" value="&lt;b&gt;✕ Not recommended:&lt;/b&gt; ADF / SSIS (needs Blob staging – extra cloud component) · watermark-only delta (misses deletes) · daily full reload (moves 3–4 TB every day) · connector snapshot for history (slow at this volume)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FDF2F1;strokeColor=#E5A39B;strokeWidth=1;fontSize=11;align=left;spacingLeft=12;fontColor=#8A1C12;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="672" width="740" height="50" as="geometry" />
        </mxCell>
        <mxCell id="d-foot" value="Prepared by: Jitendra Chauhan" style="text;html=1;fontSize=10;fontColor=#7B8794;align=right;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="480" y="732" width="300" height="24" as="geometry" />
        </mxCell>
